{
  "name": "pc-movie-theater",
  "productName": "PC Movie Theater",
  "version": "1.0.0",
  "description": "A free, open-source movie & TV library for Windows: cover-flow DVD-box shelf, YouTube-style player (mpv), seasonal themes, Archive.org downloads, Xbox controller support.",
  "main": "main.js",
  "author": "Quinton Kom <271633497+quinkom@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/quinkom/pc-movie-theater",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinkom/pc-movie-theater.git"
  },
  "bugs": {
    "url": "https://github.com/quinkom/pc-movie-theater/issues"
  },
  "scripts": {
    "start": "electron .",
    "fetch-mpv": "node scripts/fetch-mpv.js",
    "icon": "electron build/make-icon.js",
    "pack": "node build/pack.js",
    "dist": "node scripts/dist.js",
    "release": "node scripts/dist.js --publish"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.quinkom.pcmovietheater",
    "productName": "PC Movie Theater",
    "copyright": "MIT License",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PC Movie Theater",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "PC-Movie-Theater-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "quinkom",
        "repo": "pc-movie-theater",
        "releaseType": "release"
      }
    ]
  }
}
